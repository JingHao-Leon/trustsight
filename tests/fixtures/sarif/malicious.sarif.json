{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "TrustSight",
          "informationUri": "https://docs.trustsight.org/",
          "rules": [
            {
              "id": "C011",
              "name": "prebuilt binary sources from {source_host}, not declared upstream {upstream_host}",
              "shortDescription": {
                "text": "prebuilt binary sources from {source_host}, not declared upstream {upstream_host}"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "layer": "L1"
              }
            },
            {
              "id": "SOURCE_BUCKET",
              "name": "SOURCE_BUCKET",
              "shortDescription": {
                "text": "SOURCE_BUCKET"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "W011",
              "name": "{match}",
              "shortDescription": {
                "text": "{match}"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "layer": "L2"
              }
            },
            {
              "id": "W012",
              "name": "{match}",
              "shortDescription": {
                "text": "{match}"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "layer": "L2"
              }
            }
          ]
        }
      },
